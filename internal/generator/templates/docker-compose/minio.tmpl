{{ define "minio" }}
  # Object Storage (S3-compatible via MinIO)
  storage:
    image: {{ .Storage.Image }}
    container_name: {{ .Storage.Container }}
    command: '{{ .Storage.Command }}'
    ports:
      - "{{ .Storage.APIPort }}:9000"
      - "{{ .Storage.WebPort }}:9001"
    volumes:
      - storage_data:/data
{{end}}
